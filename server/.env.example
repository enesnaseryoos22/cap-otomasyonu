# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env git'e eklenmez.
DATABASE_URL="postgresql://cap_app:SIFRE@localhost:5432/cap_otomasyonu"
# Tablo değişiklikleri (migrate) için doğrudan bağlantı. Yerelde DATABASE_URL ile aynı;
# Neon'da havuzsuz (DATABASE_URL_UNPOOLED) adres yazılır.
DIRECT_URL="postgresql://cap_app:SIFRE@localhost:5432/cap_otomasyonu"
# Oturum jetonu imza anahtarı: en az 32 karakter, rastgele
JWT_SECRET="en-az-32-karakterlik-rastgele-bir-deger"
PORT=3000
# Canlı ortamda production yazılır (güvenli çerez, vekil sunucu ayarı)
NODE_ENV=development
# Seed ile oluşturulan deneme hesaplarının şifresi
DEMO_SIFRE="Demo.2026!"
