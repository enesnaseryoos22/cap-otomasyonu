    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.45.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
